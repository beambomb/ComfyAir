# ComfyAir Backend Environment Variables Template

# Runtime Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,https://beambomb.github.io

# Auth / Security (Ganti JWT_SECRET saat deploy produksi di Azure)
JWT_SECRET=comfyair-dev-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Local SQLite Fallback (digunakan otomatis bila Supabase belum dikonfigurasi)
SQLITE_PATH=comfyair.db

# Supabase PostgreSQL Cloud (Opsional, ambil dari Project Settings -> API)
SUPABASE_URL=
SUPABASE_KEY=

# OpenWeatherMap API (Opsional, layanan utama memakai Open-Meteo HTTPS API)
OPENWEATHER_API_KEY=
