# ComfyAir Backend Environment Variables Template

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Supabase (Ambil dari Project Settings -> API di Supabase Dashboard)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# OpenWeatherMap API (Opsional, fallback data cuaca akan digunakan jika kosong)
OPENWEATHER_API_KEY=
