# Salin ke .env.local lalu sesuaikan.
#
# Alamat backend FastAPI ComfyAir, tanpa garis miring di akhir.
# Nilainya ditanam ke bundle saat `npm run build`, jadi build ulang setelah mengubahnya.
# Kalau kosong atau tidak diisi, frontend memakai http://localhost:8000.
# Kalau backend tidak bisa dihubungi, halaman tetap jalan dengan rumus adaptif di browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
